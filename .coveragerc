[run]
branch = true
source = src/taxdumpy
omit =
    */tests/*
    */venv/*
    */__pycache__/*
    */.*
    setup.py

[report]
exclude_lines =
    pragma: no cover
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
